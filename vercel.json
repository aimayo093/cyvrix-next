{
  "framework": "nextjs",
  "buildCommand": "npm run prisma:generate && npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/security-scan",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/email-sync",
      "schedule": "30 6 * * *"
    }
  ]
}
